# Supabase (pre-configured in .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge function secrets (set via Supabase Vault or dashboard)
# INTEGRATION_ENCRYPTION_KEY - 32-byte hex key for encrypting integration secrets
# META_APP_SECRET - Used by meta-lead-webhook for signature verification

# Communication providers (optional - demo mode works without these)
# TWILIO_ACCOUNT_SID - Twilio account SID for SMS and calls
# TWILIO_AUTH_TOKEN - Twilio auth token
# TWILIO_PHONE_NUMBER - Twilio sender phone number

# Future providers (not yet implemented)
# RINGOVER_API_KEY - Ringover API key
# THREecx_API_KEY - 3CX API key
# OCTOPUSH_API_KEY - Octopush API key for SMS
