Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Les vrais fichiers construits (JS, CSS, images, manifeste) sont servis
  # normalement. Toutes les routes du CRM reviennent vers React.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Les ressources compilees portent une empreinte dans leur nom. Elles sont
  # immuables et peuvent rester longtemps en cache sans masquer une mise a jour.
  <FilesMatch "\.(css|js|png|jpg|jpeg|svg|webp|woff|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Le point d'entree et le service worker doivent etre verifies a chaque
  # ouverture. La regle reste en dernier car sw.js correspond aussi a
  # l'extension .js et ne doit jamais etre conserve comme une ressource immuable.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
